{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build SDL2 Project",
            "type": "shell",
            "command": "C:/msys64/mingw64/bin/gcc.exe",
            "args": [
                "ray_tracing_sdl.c",
                "-o",
                "ray_tracing_sdl.exe",
                "-IC:/msys64/mingw64/include/SDL2",
                "-LC:/msys64/mingw64/lib",
                "-lSDL2",
                "-mconsole"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}